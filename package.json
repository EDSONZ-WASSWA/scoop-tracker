{
  "name": "scoop-tracker",
  "version": "1.0.0",
  "description": "Live ice cream stock, sales and refill tracker built on MongoDB",
  "private": true,
  "type": "module",
  "scripts": {
    "build:client": "tsc -p tsconfig.client.json",
    "build:server": "tsc -p tsconfig.json",
    "build": "npm run build:client && npm run build:server",
    "dev": "npm run build:client && tsx watch src/server/index.ts",
    "start": "node dist/server/index.js",
    "seed": "tsx src/server/seed.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "mongodb": "^7.8.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
